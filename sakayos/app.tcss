/* SakayOS — Textual CSS stylesheet */

/* ── Global ─────────────────────────────────────────────────────────────── */

Screen {
    background: $surface;
}

/* ── Home Screen ────────────────────────────────────────────────────────── */

#home-container {
    padding: 1 4 1 4;
}

#home-title {
    text-style: bold;
    color: $accent;
    text-align: center;
    width: 100%;
    padding: 0 0 1 0;
}

#home-description {
    color: $text-muted;
    text-align: center;
    width: 56;
    padding: 0 0 1 0;
}

#module-list {
    width: 58;
    height: auto;
    align-horizontal: center;
    margin: 1 0;
}

.module-card {
    height: auto;
    padding: 1 2;
    margin: 0 0 1 0;
    background: $surface-lighten-1;
    border: tall $primary 30%;
}

.module-title {
    color: $accent;
    text-style: bold;
}

.module-description {
    color: $text-muted;
    padding: 0 0 1 0;
}

#home-container Button {
    width: 16;
    margin: 0;
}

/* ── Module Screens (Passenger, Dispatch, Seat Allocator) ───────────────── */

.screen-container {
    padding: 2 4;
}

.screen-header {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    align-horizontal: center;
}

#screen-title {
    text-style: bold;
    color: $accent;
    text-align: center;
    width: 100%;
    padding: 0 0 1 0;
}

.short-description {
    color: $text-muted;
    text-align: center;
    width: 64;
    padding: 0;
}

#btn-back {
    width: 30;
    margin: 1 0;
}

/* ── Analogy / Help Elements ───────────────────────────────────────────── */

#home-glossary {
    color: $text-muted;
    text-align: center;
    width: 58;
    padding: 0;
}

.compact-help {
    color: $text-muted;
    padding: 0 1;
    margin: 0 1 1 1;
    border-left: thick $primary 40%;
    background: $primary 5%;
}

/* ── Dispatch Scheduler — Form Fields ──────────────────────────────────── */

.form-section {
    height: auto;
    margin: 0 1 1 1;
    padding: 0;
}

.section-label {
    color: $text;
    text-style: bold;
    padding: 0 0 0 1;
}

.field-label {
    color: $accent;
    text-style: bold;
    padding: 0 1 0 1;
}

.hint-label {
    color: $text-muted;
    padding: 0 0 0 1;
}

#algo-select {
    margin: 0 1 1 1;
    width: 54;
}

#process-input {
    margin: 0 1 1 1;
    height: 7;
    max-width: 72;
}

#quantum-input {
    margin: 0 1 1 1;
    width: 30;
}

.action-button-row {
    padding: 0;
    margin: 1 0;
}

.action-button-row Button {
    margin: 0 1 0 0;
    width: 18;
}

/* ── Dispatch Scheduler — Error & Results ──────────────────────────────── */

#error-display {
    color: $error;
    background: $error 10%;
    padding: 1 2;
    margin: 1 1;
    border: tall $error;
}

.result-section {
    padding: 1 2;
    margin: 0 1 1 1;
}

.empty-state {
    color: $text-muted;
    text-align: center;
    border: tall $primary 30%;
    background: $primary 5%;
}

.status-line {
    color: $text-muted;
    padding: 0 1 1 1;
    margin: 0 1;
}

/* ── Form Inputs ───────────────────────────────────────────────────────── */

.form-row {
    height: auto;
    margin: 0 1 1 1;
    padding: 0;
    align-vertical: middle;
}

.short-input {
    width: 18;
    margin: 0 1;
}

#select-strategy {
    margin: 0 1 1 1;
    width: 40;
}

#select-sort {
    margin: 0 1;
    width: 30;
}

#select-limit {
    margin: 0 1;
    width: 20;
}

#memory-status {
    text-align: center;
}

/* ── Hidden utility ────────────────────────────────────────────────────── */

.hidden {
    display: none;
}
